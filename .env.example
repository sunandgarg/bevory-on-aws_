# MySQL database used by Prisma
DATABASE_URL="mysql://bevory:bevory@127.0.0.1:3306/bevory"

# Backend authentication (replace in every shared/production environment)
JWT_SECRET="replace-with-a-long-random-secret"
ADMIN_EMAIL="admin@bevory.local"
ADMIN_PASSWORD="replace-with-a-strong-local-password"

# Runtime URLs and ports
PORT=3001
APP_URL="http://localhost:8080"
VITE_API_URL="/api"

# Optional integrations. Features degrade cleanly when omitted.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
GOOGLE_ANALYTICS_CREDENTIALS_JSON=""
AI_API_KEY=""
