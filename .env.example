# MySQL database used by Prisma
DATABASE_URL="mysql://bevory:bevory@127.0.0.1:3306/bevory"

# Backend authentication (replace in every shared/production environment)
JWT_SECRET="replace-with-a-long-random-secret"
ADMIN_EMAIL="admin@bevory.local"
ADMIN_PASSWORD="replace-with-a-strong-local-password"

# Runtime URLs and ports
PORT=3001
APP_URL="http://localhost:8080"
VITE_API_URL="/api"

# Google OAuth. Register GOOGLE_REDIRECT_URI with Google Cloud.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3001/api/auth/google/callback"

# Phone OTP through Twilio. OTP_TEST_CODE may only be used outside production.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
OTP_TEST_CODE=""

# GA4 Data API service-account JSON; store as a secret, never in app settings.
GOOGLE_ANALYTICS_CREDENTIALS_JSON=""

# Approved price provider returning an array (or items/prices/data array).
PRICE_PROVIDER_URL=""
PRICE_PROVIDER_KEY=""
PRICE_PROVIDER_KEY_HEADER=""

# Optional S3-compatible persistent uploads. Local disk is used when omitted.
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""
S3_FORCE_PATH_STYLE="false"

# Optional external AI provider reserved for a future model adapter.
AI_API_KEY=""
